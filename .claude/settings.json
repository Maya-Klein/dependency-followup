{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*expected*)",
      "Read(//c/Users/user/Dev/AI_Developers/Projects/Documents/real_thread)",
      "Read(//c/Users/user/Dev/AI_Developers/Projects/Documents/real_thread/**)",
      "Bash(*compare_eval*--mode final*)",
      "Bash(*compare_eval*--mode=final*)",
      "PowerShell(*compare_eval*--mode final*)",
      "PowerShell(*compare_eval*--mode=final*)",
      "Edit(/scripts/topic7/**)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push -f *)",
      "Bash(git push * +*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * +*)",
      "Bash(git reset *--hard*)",
      "PowerShell(git reset *--hard*)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(*python*eval_topics*)",
      "Bash(py *eval_topics*)",
      "Bash(*eval_topics.py --*)",
      "PowerShell(*python*eval_topics*)",
      "PowerShell(py *eval_topics*)",
      "PowerShell(*eval_topics.py --*)",
      "Bash(railway *)",
      "Bash(npx *railway*)",
      "PowerShell(railway *)",
      "PowerShell(npx *railway*)",
      "Bash(*pip install*)",
      "Bash(*pip3 install*)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(scoop install *)",
      "PowerShell(*pip install*)",
      "PowerShell(*pip3 install*)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(scoop install *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "PowerShell(Remove-Item *)",
      "Bash(git branch *-d*)",
      "Bash(git branch *-D*)",
      "Bash(git branch *--delete*)",
      "PowerShell(git branch *-d*)",
      "PowerShell(git branch *--delete*)",
      "Bash(*app.db*)",
      "PowerShell(*app.db*)",
      "Edit(/.claude/**)",
      "Edit(~/.claude/**)",
      "Edit(/CLAUDE.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_task.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
